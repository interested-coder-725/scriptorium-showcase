  "components": {
    "schemas": {
      "AuthorInfo": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "sort_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sort Name"
          },
          "birth_year": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Birth Year"
          },
          "role": {
            "$ref": "#/components/schemas/ContributorRole",
            "default": "author"
          },
          "metadata_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Metadata Id"
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "AuthorInfo"
      },
      "Backend": {
        "type": "string",
        "enum": [
          "audiobookshelf",
          "komga",
          "kavita"
        ],
        "title": "Backend",
        "description": "An external library server Scriptorium syncs with."
      },
      "ContentType": {
        "type": "string",
        "enum": [
          "audiobook",
          "ebook",
          "manga",
          "comic",
          "webnovel"
        ],
        "title": "ContentType",
        "description": "What kind of thing a Work is \u2014 the user-facing category."
      },
      "ContributorRole": {
        "type": "string",
        "enum": [
          "author",
          "editor",
          "translator",
          "artist",
          "contributor"
        ],
        "title": "ContributorRole"
      },
      "EditionInfo": {
        "properties": {
          "content_type": {
            "$ref": "#/components/schemas/ContentType"
          },
